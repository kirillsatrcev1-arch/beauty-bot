# Токен бота от @BotFather (никому не показывайте!)
BOT_TOKEN=

# Telegram ID мастера (и помощников) через запятую — узнать свой ID: @userinfobot
ADMIN_IDS=123456789

# Публичный HTTPS-адрес Mini App (без слэша в конце). Пусто — бот работает без Mini App.
WEBAPP_URL=

# Часовой пояс студии
TZ_NAME=Europe/Moscow

# Порт веб-сервера Mini App (на хостингах обычно задаётся переменной PORT)
PORT=8080

# Где хранить базу, обложки и кэш фото (по умолчанию ./data)
# DATA_DIR=/data
